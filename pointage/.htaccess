DirectoryIndex index.php
Options -Indexes

AddType application/manifest+json .webmanifest

# Configuration et fichiers de déploiement : jamais servis
<FilesMatch "^(config(\.sample)?\.php|\.ftp-deploy-sync-state\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    <FilesMatch "sw\.js$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
